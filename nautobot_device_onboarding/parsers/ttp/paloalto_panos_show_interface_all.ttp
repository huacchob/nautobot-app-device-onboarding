<group name="hardware*">
{{ name }} {{ id | DIGIT }} {{ sdsf }} {{ mac_address | re("([0-9a-fA-F]{2}[:]){5}[0-9a-fA-F]{2}") }}
</group>

<group name="logical*">
{{ name }} {{ ignore(".+") }} {{ address | re("([0-9]{1,3}[.]){3}[0-9]{1,3}/[0-9]{1,2}") }}
</group>

<group name="routing*">
{{ name }} {{ ignore(".+") }} {{ vrf | re("vr:[^ ]+") }} {{ ignore(".+") }}
</group>

<group name="aggregate*">
{{ lag }} members:
{{ members | re(".*ethernet.*") }}
</group>
