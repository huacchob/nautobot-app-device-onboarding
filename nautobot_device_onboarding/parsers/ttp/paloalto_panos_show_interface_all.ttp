<group name="hardware*">
{{ name }} {{ id | DIGIT }} {{ sdsf }} {{ mac_address | re("([0-9a-fA-F]{2}[:]){5}[0-9a-fA-F]{2}") }}
</group>

<group name="logical*" method="table">
{{ name }} {{ id | DIGIT }} {{ vsys | DIGIT }} {{ zone }} {{ forwarding | re("vr:[^ ]+") }} {{ ignore(".+") }} {{ address }}
{{ name }} {{ id | DIGIT }} {{ vsys | DIGIT }} {{ forwarding | re("N/A") }} {{ ignore(".+") }} {{ address }}
</group>

<group name="routing*">
{{ name }} {{ ignore(".+") }} {{ vrf | re("vr:[^ ]+") }} {{ ignore(".+") }}
</group>

<group name="aggregate*">
{{ lag }} members:
{{ members | re(".*ethernet.*") }}
</group>
